# Copy to .env and adjust. Never commit .env.

# Shown in the app when connecting.
INSTANCE_NAME=Friendster

# Host port the server is published on (the app connects to http(s)://<host>:<port>).
FRIENDSTER_PORT=8080

# trace, debug, info, notice, warning, error, critical
LOG_LEVEL=info

# Defines "today" for the moments rule (IANA name).
TIME_ZONE=Europe/Berlin

# Prebuilt image from GitHub Actions (optional). Leave unset to build locally.
# FRIENDSTER_IMAGE=ghcr.io/<owner>/friendster-server:latest
